{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: build",
      "type": "shell",
      "command": "go build -o /tmp/api-build . && echo 'Build OK'",
      "problemMatcher": "$go",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "api: vet",
      "type": "shell",
      "command": "go vet ./...",
      "problemMatcher": "$go"
    },
    {
      "label": "api: run",
      "type": "shell",
      "command": "go run .",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
