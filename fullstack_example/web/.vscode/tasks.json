{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": "$tsc",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "web: type-check",
      "type": "shell",
      "command": "npx tsc -p . --noEmit",
      "problemMatcher": "$tsc"
    }
  ]
}
