# Copy to .env and replace the passwords with random values.
# Seeded dev logins (see db/init/02_seed.sql):
#   admin (role admin): admin / Admin123!
#   kari, ola, ingrid, erik (role user): same usernames / User123!
MYSQL_ROOT_PASSWORD=<enter-root-password-here>
MYSQL_DATABASE=appdb
MYSQL_USER=app
MYSQL_PASSWORD=<enter-app-password-here>
DB_HOST=mysql
DB_PORT=3306
API_PORT=8080
