# Copy to .env and change every value:  cp .env.example .env
# Generate random values with:  openssl rand -hex 32

# PostgreSQL (used by both postgres and nextcloud)
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me-db-password

# First Nextcloud admin account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin-password

# Shared between Euro-Office and Nextcloud. At least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Host ports the browser uses
NEXTCLOUD_PORT=8080
EURO_OFFICE_PORT=8081
